{
  "name": "liminalia-story-import",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ink / Yarn Spinner / Ren'Py / Twine からのシナリオ変換取り込みを有効化する公式プラグイン。",
  "license": "SEE LICENSE IN LICENSE",
  "liminalia": {
    "api": 8,
